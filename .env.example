# Copy to .env and edit. .env is gitignored: it names a real account, and the
# whole point of the artifacts in results/ being scrubbed is that nothing
# committed here identifies one.
#
# Precedence, lowest to highest:
#   defaults in tools/config.py  <  .env  <  the environment  <  CLI flags
#
# Every setting below has a matching flag: IAMD_ADMIN_ROLE is --admin-role.
# Run any tool with --help for the resolved defaults.

# One of two settings with no usable default (the other is IAMD_STACK).
# Everything that touches AWS refuses to start without it, because every
# ARN the tools build is scoped by it.
IAMD_ACCOUNT=123456789012

# Region the stack deploys into. Global-service events (IAM, STS) are always
# read from us-east-1 as well, whatever this says.
IAMD_REGION=us-east-2

# Also required, and with no default on purpose. This is the substring
# purge_all() matches orphaned resources on across nine services, so a
# default would scope real deletions to a name the operator never chose.
# It is also the default ProjectName parameter. Make it distinctive.
IAMD_STACK=my-stack-iamtest

# The three service roles under test, and the admin role used to force
# teardown of a wedged stack. Create these before the first run; the
# deny-first role starts at ReadOnlyAccess and grows from there.
IAMD_ROLE=cfn-deploy-role
IAMD_ADMIN_ROLE=cfn-admin-role
IAMD_DERIVED_ROLE=cfn-derived-role
IAMD_CLEANUP_ROLE=cfn-cleanup-role

# --- optional ---------------------------------------------------------------

# Name of the managed policy the loop writes its grants into.
# IAMD_POLICY_NAME=discovered-deploy-permissions

# Template to deploy. Defaults to tools/order-pipeline-pruned.yaml.
# IAMD_TEMPLATE=

# ProjectName parameter override. Defaults to IAMD_STACK.
# IAMD_PROJECT_NAME=

# Loop bounds. Raising these costs hours, not minutes.
# IAMD_MAX_ITERS=30
# IAMD_MAX_UNINSTALLS=3
# IAMD_MAX_PASSES=15

# Console verbosity: ERROR, WARNING, INFO, DEBUG, TRACE.
# IAMD_LOG_LEVEL=INFO
